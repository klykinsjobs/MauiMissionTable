<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiMissionTable.Views.UnitDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MauiMissionTable.ViewModels"
    x:DataType="viewmodels:UnitDetailViewModel"
    BackgroundColor="{StaticResource ColorBackground}"
    Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24" Spacing="24">

                <Border Style="{StaticResource UnitPanelStyle}"
                        Stroke="{Binding Unit.Rarity, Converter={StaticResource RarityToBrushConverter}}"
                        StrokeThickness="3">
                    <VerticalStackLayout Spacing="12">

                        <Border
                            BackgroundColor="{Binding Unit.Color}"
                            HeightRequest="100"
                            Stroke="#00000060"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20" />
                        <Label
                            Text="{Binding Title}"
                            FontSize="28"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            TextColor="{StaticResource ColorTextGold}" />
                        <Label
                            Text="{Binding Unit.Level, StringFormat='Level {0}'}"
                            FontSize="18"
                            HorizontalOptions="Center"
                            TextColor="{StaticResource ColorTextSecondary}" />
                        <Label
                            Text="{Binding Unit.Rarity}"
                            FontSize="14"
                            HorizontalOptions="Center"
                            TextColor="{StaticResource ColorTextSecondary}" />

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            
                            <Label
                                Text="{Binding Unit.Xp}"
                                FontSize="14"
                                TextColor="{StaticResource ColorTextSecondary}" />

                            <Label
                                Text="{Binding XpToNextLevel, StringFormat='/ {0} XP'}"
                                FontSize="14"
                                TextColor="{StaticResource ColorTextSecondary}" />
                            
                        </HorizontalStackLayout>

                        <ProgressBar
                            Progress="{Binding XpProgress}"
                            HeightRequest="12" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="24" Spacing="24">

            <Button
                Text="Use XP Boost"
                Command="{Binding UseXpBoostCommand}" />

            <Button
                Text="Sell Unit"
                Command="{Binding SellCommand}"
                BackgroundColor="#661010"
                TextColor="White" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>