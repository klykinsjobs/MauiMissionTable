<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiMissionTable.Views.UnitsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MauiMissionTable.ViewModels"
    xmlns:models="clr-namespace:MauiMissionTable.Models"
    x:DataType="viewmodels:UnitsViewModel"
    BackgroundColor="{StaticResource ColorBackground}"
    Title="{Binding Title}">

    <Grid Padding="16">

        <CollectionView
            ItemsSource="{Binding Units}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:UnitRow">

                    <Border Style="{StaticResource UnitPanelStyle}"
                            Stroke="{Binding Unit.Rarity, Converter={StaticResource RarityToBrushConverter}}"
                            StrokeThickness="3">

                        <Grid>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenUnitCommand}"
                                    CommandParameter="{Binding}" />
                            </Grid.GestureRecognizers>

                            <VerticalStackLayout Spacing="8">

                                <Border
                                    BackgroundColor="{Binding Unit.Color}"
                                    HeightRequest="50"
                                    Stroke="#00000040"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14" />

                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    
                                    <Label
                                        Text="{Binding Unit.Title}"
                                        FontAttributes="Bold"
                                        FontSize="16" />
                                    <Label
                                        Text="{Binding Unit.Level, StringFormat='Level {0}'}"
                                        FontSize="12"
                                        TextColor="{StaticResource ColorTextSecondary}" />
                                    <Label
                                        Text="{Binding Unit.Rarity}"
                                        FontSize="10"
                                        TextColor="{StaticResource ColorTextSecondary}" />
                                    
                                </HorizontalStackLayout>

                                <ProgressBar
                                    Progress="{Binding XpProgress}"
                                    HeightRequest="8" />

                                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                    
                                    <Label
                                        Text="{Binding Unit.Xp}"
                                        FontSize="11"
                                        TextColor="{StaticResource ColorTextSecondary}" />

                                    <Label
                                        Text="{Binding XpToNextLevel, StringFormat='/ {0} XP'}"
                                        FontSize="11"
                                        TextColor="{StaticResource ColorTextSecondary}" />
                                    
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>