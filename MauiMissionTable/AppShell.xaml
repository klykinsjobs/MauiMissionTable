<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiMissionTable.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiMissionTable.Views"
    Title="Maui Mission Table">

    <TabBar>

        <ShellContent
            Title="Missions"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate views:MissionsPage}" />

        <ShellContent
            Title="Units"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate views:UnitsPage}" />

        <ShellContent
            Title="Packs"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate views:PacksPage}" />

        <ShellContent
            Title="Inventory"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate views:InventoryPage}" />

        <ShellContent
            Title="Shop"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate views:ShopPage}" />

    </TabBar>

</Shell>